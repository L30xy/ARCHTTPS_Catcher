{
    "output_dir": "arc_logs",
    "time_format": "%m-%d-%H-%M-%S",
    "naming": {
        "request": "{method}_{path}_{time}.txt",
        "response": "RESPONSE_{path}_{time}.txt",
        "fallback_req": "UNKNOWN_REQ_{time}.txt",
        "fallback_res": "RESPONSE_UNKNOWN_{time}.txt"
    },
    "extract_rules": {
        "res_extract_regex": "\"current_map\":\"([^\"]+)\""
    },
    "prompts": {
        "connecting": "[*] Connecting to {host} ...",
        "attached": "[*] Successfully attached to Gadget!",
        "attach_failed": "[-] Attach failed: {error}",
        "script_failed": "[-] Script load failed: {error}",
        "pkg_locked": "(・ω・) Target package locked: {package}",
        "capture_req": "[+] catch REQ  -> {filename}",
        "capture_res": "[+] catch RES  -> {filename}",
        "divider": "=====================================",
        "ready": "[*] Capture module loaded!",
        "data_saved": "[*] Data will be saved in '{dir}/<package>/' directory.",
        "stop_hint": "[*] Please operate the game, press Ctrl+C to stop."
    }
}